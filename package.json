{
  "name": "learning-center-management",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:start": "node scripts/ensure-db.mjs",
    "db:stop": "docker stop learning-center-sqlserver",
    "db:status": "docker ps --filter name=learning-center-sqlserver --format \"table {{.Names}}\\t{{.Status}}\\t{{.Ports}}\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend"
  }
}
